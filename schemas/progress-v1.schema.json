{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxr.dev/schemas/progress-v1.schema.json",
  "title": "nxr-progress-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "stage_id", "stage_label", "unit", "state"],
  "properties": {
    "schema_version": { "const": "nxr-progress-v1" },
    "node_id": { "type": "string", "minLength": 1 },
    "stage_id": { "type": "string", "minLength": 1 },
    "stage_label": { "type": "string", "minLength": 1 },
    "completed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "unit": {
      "oneOf": [
        { "enum": ["steps", "tests", "files", "bytes", "artifacts", "samples", "operations"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["custom"],
          "properties": { "custom": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "state": { "enum": ["pending", "running", "succeeded", "failed", "skipped", "indeterminate"] }
  }
}
