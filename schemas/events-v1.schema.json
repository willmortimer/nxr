{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxr.dev/schemas/events-v1.schema.json",
  "title": "nxr execution event",
  "description": "FROZEN (V2.0): single execution-bus event matching the Rust `Event` enum in nxr-task (internally tagged on `type`, snake_case). Additive optional fields may appear in minor releases; breaking changes require a new major schema file.",
  "oneOf": [
    { "$ref": "#/$defs/plan_created" },
    { "$ref": "#/$defs/node_queued" },
    { "$ref": "#/$defs/node_started" },
    { "$ref": "#/$defs/stdout_chunk" },
    { "$ref": "#/$defs/stderr_chunk" },
    { "$ref": "#/$defs/node_exited" },
    { "$ref": "#/$defs/artifact_reused" },
    { "$ref": "#/$defs/client_detached" },
    { "$ref": "#/$defs/phase" },
    { "$ref": "#/$defs/run_completed" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "plan_created": {
      "type": "object",
      "required": ["type", "root", "node_count"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "plan_created"
        },
        "root": {
          "type": "string",
          "description": "Primary root task id (first requested root)."
        },
        "roots": {
          "type": "array",
          "description": "All requested roots when the plan is a multi-root union.",
          "items": {
            "type": "string"
          }
        },
        "node_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of nodes in the plan."
        },
        "run_id": {
          "type": "string",
          "description": "Optional opaque run identifier shared by subsequent events."
        }
      }
    },
    "node_queued": {
      "type": "object",
      "required": ["type", "node"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "node_queued"
        },
        "node": {
          "type": "string",
          "description": "Task id."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional monotonic sequence number within the run."
        }
      }
    },
    "node_started": {
      "type": "object",
      "required": ["type", "node"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "node_started"
        },
        "node": {
          "type": "string",
          "description": "Task id."
        },
        "started_at": {
          "type": "string",
          "description": "Optional RFC 3339 UTC timestamp when the node started."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional monotonic sequence number within the run."
        }
      }
    },
    "stdout_chunk": {
      "type": "object",
      "required": ["type", "node", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stdout_chunk"
        },
        "node": {
          "type": "string",
          "description": "Task id."
        },
        "text": {
          "type": "string",
          "description": "Chunk payload. UTF-8 when encoding is absent or utf8; otherwise standard base64 of raw bytes."
        },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "base64"],
          "description": "Optional. Absent or utf8: text is a UTF-8 string. base64: text is standard base64 of arbitrary bytes."
        }
      }
    },
    "stderr_chunk": {
      "type": "object",
      "required": ["type", "node", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stderr_chunk"
        },
        "node": {
          "type": "string",
          "description": "Task id."
        },
        "text": {
          "type": "string",
          "description": "Chunk payload. UTF-8 when encoding is absent or utf8; otherwise standard base64 of raw bytes."
        },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "base64"],
          "description": "Optional. Absent or utf8: text is a UTF-8 string. base64: text is standard base64 of arbitrary bytes."
        }
      }
    },
    "node_exited": {
      "type": "object",
      "required": ["type", "node", "code"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "node_exited"
        },
        "node": {
          "type": "string",
          "description": "Task id."
        },
        "code": {
          "type": ["integer", "null"],
          "description": "Process exit code (`null` when terminated by signal / unavailable)."
        },
        "status": {
          "type": "string",
          "enum": ["succeeded", "failed", "cancelled", "skipped", "timed_out"],
          "description": "Optional structured node outcome."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional wall-clock duration in milliseconds."
        },
        "started_at": {
          "type": "string",
          "description": "Optional RFC 3339 UTC start timestamp."
        },
        "finished_at": {
          "type": "string",
          "description": "Optional RFC 3339 UTC finish timestamp."
        },
        "reason": {
          "type": "string",
          "description": "Optional cancellation/skip/timeout reason."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional monotonic sequence number within the run."
        }
      }
    },
    "artifact_reused": {
      "type": "object",
      "required": ["type", "run_id", "node", "digest", "producer_attempt", "verification_receipt", "storage_layer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "artifact_reused" },
        "run_id": { "type": "string" },
        "node": { "type": "string" },
        "digest": { "type": "string" },
        "producer_attempt": { "type": "string" },
        "verification_receipt": { "type": "string" },
        "storage_layer": { "type": "string" }
      }
    },
    "client_detached": {
      "type": "object",
      "required": ["type", "run_id", "node", "attempt_id", "sequence"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "client_detached" },
        "run_id": { "type": "string" },
        "node": { "type": "string" },
        "attempt_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "phase": {
      "type": "object",
      "required": ["type", "run_id", "node", "phase", "source", "sequence"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "phase"
        },
        "run_id": {
          "type": "string",
          "description": "Opaque run identifier."
        },
        "node": {
          "type": "string",
          "description": "Task or app id this phase belongs to."
        },
        "attempt_id": {
          "type": "string",
          "description": "Remote attempt id, when the phase came from a worker journal."
        },
        "phase": {
          "type": "string",
          "enum": [
            "resolving",
            "preparing_source",
            "queued",
            "assigned",
            "running",
            "publishing",
            "retrieving",
            "verified",
            "terminal"
          ],
          "description": "Observed phase. Order is the producer sequence."
        },
        "source": {
          "type": "string",
          "description": "Who produced the observation."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Producer sequence. This is the order, not a timestamp."
        },
        "detail": {
          "type": "string",
          "description": "Optional short context."
        }
      }
    },
    "run_completed": {
      "type": "object",
      "required": ["type", "success"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "run_completed"
        },
        "success": {
          "type": "boolean",
          "description": "Whether every required node succeeded under the active failure policy."
        },
        "run_id": {
          "type": "string",
          "description": "Optional opaque run identifier."
        },
        "status": {
          "type": "string",
          "enum": ["succeeded", "failed", "cancelled"],
          "description": "Optional structured overall outcome."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional wall-clock duration of the whole run in milliseconds."
        },
        "started_at": {
          "type": "string",
          "description": "Optional RFC 3339 UTC start timestamp."
        },
        "finished_at": {
          "type": "string",
          "description": "Optional RFC 3339 UTC finish timestamp."
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "diagnostic"
        },
        "message": {
          "type": "string",
          "description": "Human-readable message (already sanitized for terminals by the emitter)."
        }
      }
    }
  }
}
