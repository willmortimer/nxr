{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxr.dev/schemas/execution-plan-v1.schema.json",
  "title": "nxr execution plan",
  "description": "FROZEN (V2.0): machine-readable execution-plan envelope (schema version 1). Additive optional fields may appear in minor releases; breaking changes require a new major schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "failure_policy",
    "nodes",
    "serial_order"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "root": {
      "type": "string",
      "description": "Primary root task id (first requested root)."
    },
    "roots": {
      "type": "array",
      "description": "All requested roots when the plan is a multi-root union.",
      "items": {
        "type": "string"
      }
    },
    "failure_policy": {
      "type": "string",
      "enum": ["fail_fast", "keep_going"],
      "description": "Scheduler reaction when a node fails."
    },
    "nodes": {
      "type": "array",
      "description": "Reachable subgraph nodes in lexicographic id order.",
      "items": {
        "$ref": "#/$defs/plan_node"
      }
    },
    "serial_order": {
      "type": "array",
      "description": "Deterministic serial execution order (dependencies before dependents).",
      "items": {
        "type": "string"
      }
    },
    "waves": {
      "type": "array",
      "description": "Optional parallel-ready waves; serial plans use one task id per wave.",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "plan_node": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interactive": {
          "type": "boolean",
          "default": false,
          "description": "When true, the scheduler runs this node exclusively (stdin/terminal inherited; no concurrent peers)."
        },
        "operation": {
          "description": "Additive desugared operation. Omitted on plans produced before this field. Flake tasks use kind flake_app. The scheduler ignores it.",
          "$ref": "#/$defs/operation"
        },
        "platform": {
          "description": "Optional workflow platform. Omitted for flake-task plans.",
          "type": "string",
          "enum": ["any", "unix", "windows"]
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "flake_app" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "installable"],
          "properties": {
            "kind": { "const": "nix_build" },
            "installable": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "argv"],
          "properties": {
            "kind": { "const": "native_command" },
            "argv": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "workspace_script" },
            "path": { "type": "string" },
            "interpreter": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "task_id"],
          "properties": {
            "kind": { "const": "win_build_task" },
            "task_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "remote" },
            "target": { "type": "string" }
          }
        }
      ]
    }
  }
}
